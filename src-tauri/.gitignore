# Generated by Cargo
# will have compiled files and executables
/target/

# Generated by Tauri
# will have schema files for capabilities auto-completion
/gen/schemas

# ONNX Runtime partagée (téléchargée + vérifiée par build.rs, ~50-100 Mo)
# embarquée via bundle.resources ; recréée à chaque build si absente.
# Le .gitkeep reste versionné pour que le glob resources matche toujours.
/ort-dylibs/*
!/ort-dylibs/.gitkeep
/.ort-dylib-cache/
